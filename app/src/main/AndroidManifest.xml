<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permissions for test request -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Service and notification permissions for Android 12/13/14/15 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name="com.shivam.whatsappai.WhatsAppAssistantApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhatsAppAIAssistant"
        android:usesCleartextTraffic="true">

        <!-- Splash Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.WhatsAppAIAssistant.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.home.MainActivity"
            android:exported="false"
            android:label="@string/title_home" />

        <!-- Settings Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName="com.shivam.whatsappai.ui.home.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.shivam.whatsappai.ui.home.MainActivity" />
        </activity>

        <!-- Service & Webhook Logs Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.logs.LogsActivity"
            android:exported="false"
            android:label="Logs"
            android:parentActivityName="com.shivam.whatsappai.ui.home.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.shivam.whatsappai.ui.home.MainActivity" />
        </activity>

        <!-- Diagnostics Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:label="Diagnostics"
            android:parentActivityName="com.shivam.whatsappai.ui.home.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.shivam.whatsappai.ui.home.MainActivity" />
        </activity>

        <!-- About Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.about.AboutActivity"
            android:exported="false"
            android:label="About &amp; Version History"
            android:parentActivityName="com.shivam.whatsappai.ui.home.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.shivam.whatsappai.ui.home.MainActivity" />
        </activity>

        <!-- Build Verification Screen Activity -->
        <activity
            android:name="com.shivam.whatsappai.ui.build.BuildVerificationActivity"
            android:exported="false"
            android:label="Build Verification"
            android:parentActivityName="com.shivam.whatsappai.ui.home.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.shivam.whatsappai.ui.home.MainActivity" />
        </activity>

        <!-- Notification Listener Service -->
        <service
            android:name="com.shivam.whatsappai.WhatsAppNotificationListenerService"
            android:exported="true"
            android:label="WhatsApp AI Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Accessibility Interaction Service -->
        <service
            android:name="com.shivam.whatsappai.WhatsAppAccessibilityService"
            android:exported="true"
            android:label="WhatsApp AI Auto-Responder Service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.view.accessibility.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.view.accessibility.AccessibilityService"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
